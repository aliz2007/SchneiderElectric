# Copy this file to .env.local and fill in your key to enable AI-written PDF feedback.
#   cp .env.example .env.local
# .env.local is git-ignored so your key never leaves your machine. Without it, the PDF
# uses the built-in deterministic narrative instead (nothing breaks).

# Kimi (Moonshot AI) API key — required to turn on AI feedback.
MOONSHOT_API_KEY=

# Optional overrides:
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1   # or https://api.moonshot.cn/v1 for the China platform
# MOONSHOT_MODEL=kimi-k2-0711-preview            # default; or kimi-latest / moonshot-v1-128k
# MOONSHOT_TIMEOUT_MS=20000
# MOONSHOT_ENABLED=0                             # force the deterministic narrative even if a key is set
